# GMPilot 配置文件
# 复制此文件为 .env 并填入你的配置
# 环境变量命名与 AuditBee 保持一致，可共享同一套 API Key

# ============================================================================
# 统一配置模式（推荐）
# 使用 LLM_API_KEY、LLM_BASE_URL、LLM_MODEL 三个变量配置所有 Provider
# 系统会根据 URL 自动识别 Provider 类型
# ============================================================================

# LLM_API_KEY=your-api-key-here
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ============================================================================
# 分 Provider 配置模式
# 为每个 Provider 单独配置 API Key、Base URL、Model
# 优先级：分 Provider 配置 > 统一配置
# ============================================================================

# 默认 LLM Provider: deepseek | qwen | glm | openai | anthropic | siliconflow | openrouter | mimo | ollama
AGENT_LLM_PROVIDER=mimo

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 通义千问 (Qwen)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 智谱 (GLM)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# SiliconFlow
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.2

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat

# Mimo (推荐)
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# Ollama (本地模型)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Embedding: local | openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# 应用配置
APP_DATA_DIR=./data
LOG_LEVEL=info

# AuditBee 集成（可选）
AUDITBEE_BASE_URL=http://localhost:8000
