{
  "name": "gmpilot",
  "version": "0.1.0",
  "description": "GMPilot - 閸掓儼宓傜悰灞肩瑹GMP閸嬪繐妯婇幎銉ユ啞閻㈢喐鍨氬銉ュ徔",
  "author": "GMPilot Team",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "npm run native:electron && electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.mts",
    "build": "electron-vite build && node scripts/copy-worker.cjs && node scripts/prepare-word-template.cjs",
    "build:win": "electron-vite build && node scripts/copy-worker.cjs && node scripts/prepare-word-template.cjs && npm run native:electron && electron-builder --win dir && npm run native:node",
    "build:mac": "electron-vite build && node scripts/copy-worker.cjs && node scripts/prepare-word-template.cjs && npm run native:electron && electron-builder --mac && npm run native:node",
    "rebuild": "electron-rebuild",
    "native:node": "node scripts/switch-native-abi.cjs --to node",
    "native:electron": "node scripts/switch-native-abi.cjs --to electron",
    "lint": "eslint src/ electron/ core/",
    "format": "prettier --write src/ electron/ core/",
    "typecheck": "tsc --noEmit",
    "codegen": "tsx scripts/codegen-types.ts",
    "download:model": "tsx scripts/download-embedding-model.ts",
    "test": "npm run native:node && vitest run --exclude \"**/*.llm-e2e.test.ts\"",
    "test:watch": "npm run native:node && vitest --exclude \"**/*.llm-e2e.test.ts\"",
    "test:llm": "npm run native:node && vitest run llm-e2e",
    "test:e2e": "npx playwright test",
    "test:e2e:packaged": "npx playwright test --config playwright.packaged.config.ts",
    "test:e2e:ui": "npx playwright test --ui",
    "build:portable": "electron-vite build && node scripts/copy-worker.cjs && node scripts/prepare-word-template.cjs && npm run native:electron && electron-builder --win portable && npm run native:node"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "1.2.12",
    "@ai-sdk/openai": "1.3.24",
    "@huggingface/transformers": "4.2.0",
    "@react-pdf/renderer": "4.5.1",
    "ai": "4.3.19",
    "better-sqlite3": "12.11.1",
    "docxtemplater": "^3.69.3",
    "dotenv": "16.6.1",
    "electron-updater": "6.8.9",
    "exceljs": "4.4.0",
    "mammoth": "1.12.0",
    "motion": "^12.43.0",
    "ollama-ai-provider": "1.2.0",
    "pdf-parse": "2.4.5",
    "pizzip": "^3.2.0",
    "sqlite-vec": "0.1.9",
    "xstate": "5.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/react": "3.0.199",
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "4.3.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.19",
    "@types/react": "18.3.30",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "42.0.1",
    "electron-builder": "26.15.7",
    "electron-vite": "2.3.0",
    "eslint": "9.39.4",
    "gsap": "3.15.0",
    "jsdom": "29.1.1",
    "lucide-react": "0.468.0",
    "prettier": "3.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "3.0.0"
  }
}
