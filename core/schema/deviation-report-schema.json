{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gmpilot/deviation-report",
  "title": "GMP偏差调查和风险评估报告",
  "titleEn": "Deviation Investigation and Risk Assessment Report",
  "version": "1.0.0",
  "description": "偏差报告完整数据结构，基于 docs/template-structure-analysis.md 定义。此文件为单一真相源，types.ts / caller.ts / prompt 模板均从此文件派生。",

  "definitions": {
    "preparedBy": {
      "type": "object",
      "title": "起草人",
      "properties": {
        "department": { "type": "string", "title": "部门", "description": "起草人所在部门", "default": "" },
        "name": { "type": "string", "title": "姓名", "default": "" },
        "signatureDate": { "type": "string", "title": "签字日期", "default": "" }
      },
      "required": ["department", "name", "signatureDate"]
    },
    "reviewedBy": {
      "type": "object",
      "title": "审核人",
      "properties": {
        "department": { "type": "string", "title": "部门", "description": "审核人所在部门", "default": "" },
        "name": { "type": "string", "title": "姓名", "default": "" },
        "signatureDate": { "type": "string", "title": "签字日期", "default": "" }
      },
      "required": ["department", "name", "signatureDate"]
    },
    "repeatDeviationRecord": {
      "type": "object",
      "title": "重复偏差记录",
      "properties": {
        "no": { "type": "string", "title": "序号" },
        "time": { "type": "string", "title": "发生时间" },
        "deviationNo": { "type": "string", "title": "偏差编号" },
        "description": { "type": "string", "title": "偏差描述" },
        "rootCause": { "type": "string", "title": "根本原因" },
        "capa": { "type": "string", "title": "CAPA措施" }
      },
      "required": ["no", "time", "deviationNo", "description", "rootCause", "capa"]
    },
    "otherProductRecord": {
      "type": "object",
      "title": "其他产品/批次记录",
      "properties": {
        "no": { "type": "string", "title": "序号" },
        "productName": { "type": "string", "title": "产品名称" },
        "batchNo": { "type": "string", "title": "批次号" },
        "currentStatus": { "type": "string", "title": "当前状态" }
      },
      "required": ["no", "productName", "batchNo", "currentStatus"]
    },
    "investigationScopeRecord": {
      "type": "object",
      "title": "调查范围记录",
      "properties": {
        "category": { "type": "string", "title": "调查范围" },
        "details": { "type": "string", "title": "调查内容" },
        "ruledInOut": { "type": "string", "title": "识别的风险点" }
      },
      "required": ["category", "details", "ruledInOut"]
    },
    "capaRecord": {
      "type": "object",
      "title": "CAPA记录",
      "properties": {
        "capaNo": { "type": "string", "title": "CAPA编号" },
        "content": { "type": "string", "title": "措施内容" },
        "executor": { "type": "string", "title": "执行人" },
        "expectedDate": { "type": "string", "title": "预期完成日期" },
        "signatureDate": { "type": "string", "title": "签名日期", "default": "" }
      },
      "required": ["capaNo", "content", "executor", "expectedDate", "signatureDate"]
    },
    "attachment": {
      "type": "object",
      "title": "附件",
      "properties": {
        "no": { "type": "string", "title": "编号" },
        "name": { "type": "string", "title": "附件名称" },
        "pages": { "type": "string", "title": "总页数", "description": "附件总页数，如「15页」" }
      },
      "required": ["no", "name", "pages"]
    },
    "versionHistory": {
      "type": "object",
      "title": "版本历史",
      "properties": {
        "version": { "type": "string", "title": "版本号" },
        "executionDate": { "type": "string", "title": "执行日期" },
        "revisionReason": { "type": "string", "title": "修订原因" },
        "mainChanges": { "type": "string", "title": "主要变更" }
      },
      "required": ["version", "executionDate", "revisionReason", "mainChanges"]
    }
  },

  "type": "object",
  "properties": {
    "cover": {
      "type": "object",
      "title": "封面",
      "section": "封面区域",
      "properties": {
        "title": {
          "type": "string",
          "title": "报告标题",
          "description": "动态标题，格式：<偏差对象>偏差调查和风险评估报告，如「RT探头（编号：NBQ6）偏差调查和风险评估报告」",
          "default": "偏差调查和风险评估报告"
        },
        "titleEn": {
          "type": "string",
          "title": "报告标题(英文)",
          "description": "动态英文标题，格式：Deviation Investigation and Risk Assessment Report for <Object>",
          "default": "Deviation Investigation and Risk Assessment Report"
        },
        "department": {
          "type": "string",
          "title": "部门",
          "description": "偏差发生部门"
        },
        "preparedBy": { "$ref": "#/definitions/preparedBy" },
        "reviewedBy": { "$ref": "#/definitions/reviewedBy" }
      },
      "required": ["title", "titleEn", "department", "preparedBy", "reviewedBy"]
    },

    "background": {
      "type": "object",
      "title": "背景",
      "section": "1. 背景 Background",
      "properties": {
        "product": {
          "type": "string",
          "title": "涉及产品",
          "description": "涉及产品名称"
        },
        "batch": {
          "type": "string",
          "title": "批次号",
          "description": "涉及批次号"
        },
        "occurrenceTime": {
          "type": "string",
          "title": "发生时间",
          "description": "偏差发生的具体时间"
        },
        "location": {
          "type": "string",
          "title": "发生地点",
          "description": "偏差发生的具体位置"
        },
        "description": {
          "type": "string",
          "title": "偏差描述",
          "description": "详细描述偏差现象、涉及的产品/批次/设备",
          "ui": { "multiline": true }
        },
        "photos": {
          "type": "array",
          "title": "照片",
          "items": { "type": "string" },
          "default": []
        }
      },
      "required": ["product", "batch", "occurrenceTime", "location", "description"]
    },

    "investigation": {
      "type": "object",
      "title": "偏差调查",
      "section": "2. 偏差调查 Deviation Investigation",
      "properties": {
        "investigationIntro": {
          "type": "string",
          "title": "偏差调查引导句",
          "description": "偏差调查过程引言（如「发生偏差后，验证部验证人员XX立即上报验证主管并通知分管QA，QA组织和协调偏差涉及相关部门对偏差进行根源调查，调查过程如下：」）",
          "ui": { "multiline": true }
        },
        "rootCause": {
          "type": "object",
          "title": "根本原因调查",
          "section": "2.1 根本原因调查 Root Cause Investigation",
          "properties": {
            "preliminaryAnalysis": {
              "type": "string",
              "title": "初步分析",
              "description": "调查前的初步分析与风险点识别（如适用）",
              "ui": { "multiline": true }
            },
            "investigationScope": {
              "type": "array",
              "title": "调查范围",
              "description": "识别的风险点排查表（如适用）",
              "items": { "$ref": "#/definitions/investigationScopeRecord" },
              "default": []
            },
            "factors": {
              "type": "object",
              "title": "人机料法环测调查",
              "description": "从人、机、料、法、环、测六个方面进行全面调查的结果",
              "properties": {
                "man": { "type": "string", "title": "人员", "description": "人员因素调查结果", "ui": { "multiline": true } },
                "machine": { "type": "string", "title": "设备", "description": "设备因素调查结果", "ui": { "multiline": true } },
                "material": { "type": "string", "title": "物料", "description": "物料因素调查结果", "ui": { "multiline": true } },
                "method": { "type": "string", "title": "方法", "description": "工艺方法因素调查结果", "ui": { "multiline": true } },
                "environment": { "type": "string", "title": "环境", "description": "环境因素调查结果", "ui": { "multiline": true } },
                "measurement": { "type": "string", "title": "测量", "description": "测量因素调查结果", "ui": { "multiline": true } }
              },
              "required": ["man", "machine", "material", "method", "environment", "measurement"]
            },
            "methods": {
              "type": "object",
              "title": "调查分析方法",
              "properties": {
                "flowchart": { "type": "boolean", "title": "事件流程图", "default": false },
                "fishbone": { "type": "boolean", "title": "鱼骨图", "default": false },
                "brainstorm": { "type": "boolean", "title": "头脑风暴", "default": false },
                "photos": { "type": "array", "title": "分析工具图片", "items": { "type": "string" }, "default": [] }
              },
              "required": ["flowchart", "fishbone", "brainstorm", "photos"]
            },
            "conclusion": {
              "type": "string",
              "title": "调查结论",
              "description": "全面调查得出的结论",
              "ui": { "multiline": true }
            }
          },
          "required": ["factors", "methods", "conclusion"]
        },
        "repeatDeviations": {
          "type": "object",
          "title": "重复偏差调查",
          "section": "2.2 重复偏差调查 Repeat Deviation Investigation",
          "properties": {
            "records": {
              "type": "array",
              "title": "历史偏差记录",
              "description": "24个月内的历史偏差",
              "items": { "$ref": "#/definitions/repeatDeviationRecord" },
              "default": []
            },
            "analysis": {
              "type": "string",
              "title": "重复偏差分析",
              "ui": { "multiline": true }
            },
            "conclusion": {
              "type": "string",
              "title": "重复偏差结论",
              "ui": { "multiline": true }
            }
          },
          "required": ["records", "analysis", "conclusion"]
        },
        "otherProducts": {
          "type": "object",
          "title": "其他产品/批次调查",
          "section": "2.3 其他产品或批次调查 Investigation of Other Product or Batch",
          "properties": {
            "records": {
              "type": "array",
              "title": "受影响产品/批次",
              "description": "可能受影响的产品/批次",
              "items": { "$ref": "#/definitions/otherProductRecord" },
              "default": []
            },
            "analysis": {
              "type": "string",
              "title": "影响分析",
              "ui": { "multiline": true }
            },
            "conclusion": {
              "type": "string",
              "title": "影响结论",
              "ui": { "multiline": true }
            }
          },
          "required": ["records", "analysis", "conclusion"]
        }
      },
      "required": ["rootCause", "repeatDeviations", "otherProducts"]
    },

    "conclusion": {
      "type": "object",
      "title": "调查结论",
      "section": "3. 调查结论 Investigation Conclusion",
      "properties": {
        "rootCause": {
          "type": "string",
          "title": "根本原因",
          "ui": { "multiline": true }
        },
        "mostLikelyCause": {
          "type": "string",
          "title": "最有可能原因",
          "description": "如无法确定根本原因时填写",
          "ui": { "multiline": true }
        }
      },
      "required": ["rootCause"]
    },

    "riskAssessment": {
      "type": "object",
      "title": "风险分析",
      "section": "4. 风险分析及影响评估 Risks Analysis and Impact Assessment",
      "properties": {
        "description": {
          "type": "string",
          "title": "风险分析叙述",
          "description": "对产品质量、稳定性、注册、客户、验证有效性的整体影响进行叙述性分析（可多段，用换行分隔）",
          "ui": { "multiline": true }
        },
        "summary": {
          "type": "string",
          "title": "小结",
          "description": "风险分析小结（如「小结：1）...；2）...」）",
          "ui": { "multiline": true }
        }
      },
      "required": ["description"]
    },

    "capa": {
      "type": "object",
      "title": "纠正预防措施",
      "section": "5. 纠正预防措施 CAPA",
      "properties": {
        "corrections": {
          "type": "array",
          "title": "纠正措施",
          "section": "5.1 纠正措施",
          "items": { "$ref": "#/definitions/capaRecord" },
          "default": []
        },
        "preventions": {
          "type": "array",
          "title": "预防措施",
          "section": "5.2 预防措施",
          "items": { "$ref": "#/definitions/capaRecord" },
          "default": []
        }
      },
      "required": ["corrections", "preventions"]
    },

    "attachments": {
      "type": "array",
      "title": "附件清单",
      "section": "6. 附件清单 Attachment List",
      "items": { "$ref": "#/definitions/attachment" },
      "default": []
    },

    "versionHistory": {
      "type": "array",
      "title": "版本修订历史",
      "section": "7. 版本修订历史 Version Revision History",
      "items": { "$ref": "#/definitions/versionHistory" },
      "default": []
    }
  },

  "required": ["cover", "background", "investigation", "conclusion", "riskAssessment", "capa", "attachments", "versionHistory"]
}
