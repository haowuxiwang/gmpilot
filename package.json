{
  "name": "gmpilot",
  "version": "0.1.0",
  "description": "GMPilot - 制药行业GMP偏差报告生成工具",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.mts",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "rebuild": "electron-rebuild",
    "postinstall": "electron-rebuild",
    "lint": "eslint src/ electron/ core/",
    "format": "prettier --write src/ electron/ core/",
    "typecheck": "tsc --noEmit",
    "codegen": "tsx scripts/codegen-types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "1.2.12",
    "@ai-sdk/openai": "1.3.24",
    "@ai-sdk/react": "3.0.199",
    "@huggingface/transformers": "4.2.0",
    "@react-pdf/renderer": "4.5.1",
    "ai": "4.3.19",
    "better-sqlite3": "11.10.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "lucide-react": "0.468.0",
    "mammoth": "1.12.0",
    "ollama-ai-provider": "1.2.0",
    "pdf-parse": "2.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.16.0",
    "sqlite-vec": "0.1.9",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "xlsx": "0.18.5",
    "xstate": "5.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "4.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.19",
    "@types/react": "18.3.30",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.6",
    "electron": "28.3.3",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "3.0.0"
  }
}
