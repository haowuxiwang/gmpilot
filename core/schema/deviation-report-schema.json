{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gmpilot/deviation-report",
  "title": "GMP偏差调查和风险评估报告",
  "titleEn": "Deviation Investigation and Risk Assessment Report",
  "version": "1.0.0",
  "description": "偏差报告完整数据结构，基于 docs/template-structure-analysis.md 定义。此文件为单一真相源，types.ts / caller.ts / prompt 模板均从此文件派生。",

  "definitions": {
    "preparedBy": {
      "type": "object",
      "title": "起草人",
      "properties": {
        "name": { "type": "string", "title": "姓名", "default": "" },
        "signatureDate": { "type": "string", "title": "签字日期", "default": "" }
      },
      "required": ["name", "signatureDate"]
    },
    "reviewedBy": {
      "type": "object",
      "title": "审核人",
      "properties": {
        "name": { "type": "string", "title": "姓名", "default": "" },
        "signatureDate": { "type": "string", "title": "签字日期", "default": "" }
      },
      "required": ["name", "signatureDate"]
    },
    "repeatDeviationRecord": {
      "type": "object",
      "title": "重复偏差记录",
      "properties": {
        "time": { "type": "string", "title": "发生时间" },
        "deviationNo": { "type": "string", "title": "偏差编号" },
        "description": { "type": "string", "title": "偏差描述" },
        "rootCause": { "type": "string", "title": "根本原因" },
        "capa": { "type": "string", "title": "CAPA措施" }
      },
      "required": ["time", "deviationNo", "description", "rootCause", "capa"]
    },
    "otherProductRecord": {
      "type": "object",
      "title": "其他产品/批次记录",
      "properties": {
        "productName": { "type": "string", "title": "产品名称" },
        "batchNo": { "type": "string", "title": "批次号" },
        "currentStatus": { "type": "string", "title": "当前状态" }
      },
      "required": ["productName", "batchNo", "currentStatus"]
    },
    "capaRecord": {
      "type": "object",
      "title": "CAPA记录",
      "properties": {
        "capaNo": { "type": "string", "title": "CAPA编号" },
        "content": { "type": "string", "title": "措施内容" },
        "executor": { "type": "string", "title": "执行人" },
        "expectedDate": { "type": "string", "title": "预期完成日期" },
        "signatureDate": { "type": "string", "title": "签名日期", "default": "" }
      },
      "required": ["capaNo", "content", "executor", "expectedDate", "signatureDate"]
    },
    "attachment": {
      "type": "object",
      "title": "附件",
      "properties": {
        "no": { "type": "string", "title": "编号" },
        "name": { "type": "string", "title": "附件名称" },
        "pages": { "type": "number", "title": "页数" }
      },
      "required": ["no", "name", "pages"]
    },
    "versionHistory": {
      "type": "object",
      "title": "版本历史",
      "properties": {
        "version": { "type": "string", "title": "版本号" },
        "executionDate": { "type": "string", "title": "执行日期" },
        "revisionReason": { "type": "string", "title": "修订原因" },
        "mainChanges": { "type": "string", "title": "主要变更" }
      },
      "required": ["version", "executionDate", "revisionReason", "mainChanges"]
    }
  },

  "type": "object",
  "properties": {
    "cover": {
      "type": "object",
      "title": "封面",
      "section": "封面区域",
      "properties": {
        "title": {
          "type": "string",
          "title": "报告标题",
          "default": "偏差调查和风险评估报告",
          "fixed": true
        },
        "titleEn": {
          "type": "string",
          "title": "报告标题(英文)",
          "default": "Deviation Investigation and Risk Assessment Report",
          "fixed": true
        },
        "department": {
          "type": "string",
          "title": "部门",
          "description": "偏差发生部门"
        },
        "preparedBy": { "$ref": "#/definitions/preparedBy" },
        "reviewedBy": { "$ref": "#/definitions/reviewedBy" }
      },
      "required": ["title", "titleEn", "department", "preparedBy", "reviewedBy"]
    },

    "background": {
      "type": "object",
      "title": "背景",
      "section": "1. 背景 Background",
      "properties": {
        "product": {
          "type": "string",
          "title": "涉及产品",
          "description": "涉及产品名称"
        },
        "batch": {
          "type": "string",
          "title": "批次号",
          "description": "涉及批次号"
        },
        "occurrenceTime": {
          "type": "string",
          "title": "发生时间",
          "description": "偏差发生的具体时间"
        },
        "location": {
          "type": "string",
          "title": "发生地点",
          "description": "偏差发生的具体位置"
        },
        "description": {
          "type": "string",
          "title": "偏差描述",
          "description": "详细描述偏差现象、涉及的产品/批次/设备",
          "ui": { "multiline": true }
        },
        "photos": {
          "type": "array",
          "title": "照片",
          "items": { "type": "string" },
          "default": []
        }
      },
      "required": ["product", "batch", "occurrenceTime", "location", "description"]
    },

    "investigation": {
      "type": "object",
      "title": "偏差调查",
      "section": "2. 偏差调查 Deviation Investigation",
      "properties": {
        "rootCause": {
          "type": "object",
          "title": "根本原因调查",
          "section": "2.1 根本原因调查 Root Cause Investigation",
          "properties": {
            "interviews": {
              "type": "string",
              "title": "人员面谈记录",
              "description": "培训、SOP执行、责任心等",
              "ui": { "multiline": true }
            },
            "sopReview": {
              "type": "string",
              "title": "SOP核查结果",
              "description": "工艺规程、岗位操作法清晰度",
              "ui": { "multiline": true }
            },
            "historicalData": {
              "type": "string",
              "title": "历史数据回顾",
              "description": "分析方法、验证报告、年度回顾等",
              "ui": { "multiline": true }
            },
            "relatedBatches": {
              "type": "string",
              "title": "关联批次调查",
              "description": "其他可能相关的批次",
              "ui": { "multiline": true }
            },
            "batchRecords": {
              "type": "string",
              "title": "批记录复核",
              "description": "批记录、辅助记录、设备日志",
              "ui": { "multiline": true }
            },
            "samplesReview": {
              "type": "string",
              "title": "留样审查",
              "description": "产品/物料/留样复核",
              "ui": { "multiline": true }
            },
            "stabilityStudy": {
              "type": "string",
              "title": "稳定性考察",
              "description": "稳定性考察结果趋势",
              "ui": { "multiline": true }
            },
            "supplierReview": {
              "type": "string",
              "title": "供应商核查",
              "description": "物料供应商、设备生产厂家",
              "ui": { "multiline": true }
            },
            "methods": {
              "type": "object",
              "title": "调查分析方法",
              "properties": {
                "flowchart": { "type": "boolean", "title": "事件流程图", "default": false },
                "fishbone": { "type": "boolean", "title": "鱼骨图", "default": false },
                "brainstorm": { "type": "boolean", "title": "头脑风暴", "default": false },
                "photos": { "type": "array", "title": "分析工具图片", "items": { "type": "string" }, "default": [] }
              },
              "required": ["flowchart", "fishbone", "brainstorm", "photos"]
            },
            "humanError": {
              "type": "object",
              "title": "人员差错专项调查",
              "description": "如适用，填写M-M-M-E分析",
              "properties": {
                "machine": { "type": "string", "title": "Machine（机）", "description": "设备因素排查" },
                "material": { "type": "string", "title": "Material（料）", "description": "物料因素排查" },
                "method": { "type": "string", "title": "Method（法）", "description": "方法因素排查" },
                "environment": { "type": "string", "title": "Environment（环）", "description": "环境因素排查" }
              },
              "required": ["machine", "material", "method", "environment"]
            },
            "conclusion": {
              "type": "string",
              "title": "调查结论",
              "ui": { "multiline": true }
            }
          },
          "required": ["interviews", "sopReview", "historicalData", "relatedBatches", "batchRecords", "samplesReview", "stabilityStudy", "supplierReview", "methods", "conclusion"]
        },
        "repeatDeviations": {
          "type": "object",
          "title": "重复偏差调查",
          "section": "2.2 重复偏差调查 Repeat Deviation Investigation",
          "properties": {
            "records": {
              "type": "array",
              "title": "历史偏差记录",
              "description": "24个月内的历史偏差",
              "items": { "$ref": "#/definitions/repeatDeviationRecord" },
              "default": []
            },
            "analysis": {
              "type": "string",
              "title": "重复偏差分析",
              "ui": { "multiline": true }
            },
            "conclusion": {
              "type": "string",
              "title": "重复偏差结论",
              "ui": { "multiline": true }
            }
          },
          "required": ["records", "analysis", "conclusion"]
        },
        "otherProducts": {
          "type": "object",
          "title": "其他产品/批次调查",
          "section": "2.3 其他产品或批次调查 Investigation of Other Product or Batch",
          "properties": {
            "records": {
              "type": "array",
              "title": "受影响产品/批次",
              "description": "可能受影响的产品/批次",
              "items": { "$ref": "#/definitions/otherProductRecord" },
              "default": []
            },
            "analysis": {
              "type": "string",
              "title": "影响分析",
              "ui": { "multiline": true }
            },
            "conclusion": {
              "type": "string",
              "title": "影响结论",
              "ui": { "multiline": true }
            }
          },
          "required": ["records", "analysis", "conclusion"]
        }
      },
      "required": ["rootCause", "repeatDeviations", "otherProducts"]
    },

    "conclusion": {
      "type": "object",
      "title": "调查结论",
      "section": "3. 调查结论 Investigation Conclusion",
      "properties": {
        "rootCause": {
          "type": "string",
          "title": "根本原因",
          "ui": { "multiline": true }
        },
        "mostLikelyCause": {
          "type": "string",
          "title": "最有可能原因",
          "description": "如无法确定根本原因时填写",
          "ui": { "multiline": true }
        }
      },
      "required": ["rootCause"]
    },

    "riskAssessment": {
      "type": "object",
      "title": "风险分析",
      "section": "4. 风险分析及影响评估 Risks Analysis and Impact Assessment",
      "properties": {
        "qualityImpact": {
          "type": "string",
          "title": "产品质量影响",
          "description": "对产品质量的影响",
          "ui": { "multiline": true }
        },
        "stabilityImpact": {
          "type": "string",
          "title": "稳定性影响",
          "description": "对稳定性的影响",
          "ui": { "multiline": true }
        },
        "registrationImpact": {
          "type": "string",
          "title": "注册影响",
          "description": "对注册的影响",
          "ui": { "multiline": true }
        },
        "customerImpact": {
          "type": "string",
          "title": "客户影响",
          "description": "对客户的影响",
          "ui": { "multiline": true }
        },
        "validationImpact": {
          "type": "string",
          "title": "验证影响",
          "description": "对验证的影响",
          "ui": { "multiline": true }
        }
      },
      "required": ["qualityImpact", "stabilityImpact", "registrationImpact", "customerImpact", "validationImpact"]
    },

    "capa": {
      "type": "object",
      "title": "纠正预防措施",
      "section": "5. 纠正预防措施 CAPA",
      "properties": {
        "corrections": {
          "type": "array",
          "title": "纠正措施",
          "section": "5.1 纠正措施",
          "items": { "$ref": "#/definitions/capaRecord" },
          "default": []
        },
        "preventions": {
          "type": "array",
          "title": "预防措施",
          "section": "5.2 预防措施",
          "items": { "$ref": "#/definitions/capaRecord" },
          "default": []
        }
      },
      "required": ["corrections", "preventions"]
    },

    "attachments": {
      "type": "array",
      "title": "附件清单",
      "section": "6. 附件清单 Attachment List",
      "items": { "$ref": "#/definitions/attachment" },
      "default": []
    },

    "versionHistory": {
      "type": "array",
      "title": "版本修订历史",
      "section": "7. 版本修订历史 Version Revision History",
      "items": { "$ref": "#/definitions/versionHistory" },
      "default": []
    }
  },

  "required": ["cover", "background", "investigation", "conclusion", "riskAssessment", "capa", "attachments", "versionHistory"]
}
